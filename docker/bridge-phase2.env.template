# OpenAlpha Bridge-2K Phase 2 environment template.
#
# Copy to a location OUTSIDE the repository and fill in. Never commit a filled
# copy. No secret is required to run Phase 2: the locked provider is a public
# interface and the pinned Kronos assets are public. This file therefore holds
# only paths and execution knobs.

# --- Paths (must live outside the Git worktree) ---
OPENALPHA_RUN_DIR=/var/openalpha/runs/phase2
OPENALPHA_CACHE_DIR=/var/openalpha/cache/phase2

# Hugging Face asset cache. Public repository; no token needed.
HF_HOME=/var/openalpha/cache/huggingface
# HUGGING_FACE_HUB_TOKEN=   # leave unset; Tokenizer-2k is public

# --- Operator identity, recorded in the immutable test-opening record ---
OPENALPHA_OPERATOR=

# --- Accelerator ---
# Exactly one device. The lock caps VRAM at 25,769,803,776 bytes (24 GiB).
CUDA_VISIBLE_DEVICES=0
OPENALPHA_DEVICE=cuda

# --- Determinism ---
PYTHONHASHSEED=0
CUBLAS_WORKSPACE_CONFIG=:4096:8
